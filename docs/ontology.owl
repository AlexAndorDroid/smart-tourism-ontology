<?xml version="1.0"?>
<rdf:RDF xmlns="http://owl-ontologies.com/smarttourisminspanishcities#"
     xml:base="http://owl-ontologies.com/smarttourisminspanishcities"
     xmlns:mod="https://w3id.org/mod#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:schema="http://schema.org/"
     xmlns:smarttourisminspanishcities="http://smarttourisminspanishcities#">
    <owl:Ontology rdf:about="http://owl-ontologies.com/smarttourisminspanishcities#">
        <owl:versionIRI rdf:resource="http://owl-ontologies.com/smarttourisminspanishcities#1.8"/>
        <rdfs:comment>Main places of interest in the most attractive cities from a tourist point of view in Spain</rdfs:comment>
        <rdfs:label>Smart Tourism in Spanish Cities Ontology</rdfs:label>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.8</owl:versionInfo>
        <mod:createdWith rdf:resource="https://chowlk.linkeddata.es/"/>
        <mod:createdWith>Alex Riera</mod:createdWith>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2000/01/rdf-schema#label -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#label"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#sameAs -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#sameAs">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/mod#createdWith"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/mod#createdWith -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/mod#createdWith"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/goodrelations/v1#hasPriceSpecification -->


    <owl:ObjectProperty rdf:about="http://purl.org/goodrelations/v1#hasPriceSpecification">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Transport"/>
        <rdfs:comment>Average price for travel.</rdfs:comment>
        <rdfs:label>has price specification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/aggregateRating -->


    <owl:ObjectProperty rdf:about="http://schema.org/aggregateRating">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Attraction"/>
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Hotel"/>
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Restaurant"/>
        <rdfs:comment>Customers valorations.</rdfs:comment>
        <rdfs:label>aggregate rating</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/containsPlace -->


    <owl:ObjectProperty rdf:about="http://schema.org/containsPlace">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#City"/>
        <rdfs:range rdf:resource="http://smarttourisminspanishcities#Attraction"/>
        <rdfs:range rdf:resource="http://smarttourisminspanishcities#Hotel"/>
        <rdfs:range rdf:resource="http://smarttourisminspanishcities#Restaurant"/>
        <rdfs:comment>The city have this place.</rdfs:comment>
        <rdfs:label>contains place</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/event -->


    <owl:ObjectProperty rdf:about="http://schema.org/event">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#City"/>
        <rdfs:range rdf:resource="http://smarttourisminspanishcities#Event"/>
        <rdfs:comment>A scheduled activity or event that offers entertainment to visitors and locals in that city.</rdfs:comment>
        <rdfs:label>event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/geo -->


    <owl:ObjectProperty rdf:about="http://schema.org/geo">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#City"/>
        <rdfs:comment>GPS coordinate that specific place.</rdfs:comment>
        <rdfs:label>geo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/hotelCategory -->


    <owl:ObjectProperty rdf:about="http://schema.org/hotelCategory">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Hotel"/>
        <rdfs:comment>Type of Hotel.</rdfs:comment>
        <rdfs:label>hotel category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/priceRange -->


    <owl:ObjectProperty rdf:about="http://schema.org/priceRange">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Restaurant"/>
        <rdfs:comment>Average price for meal.</rdfs:comment>
        <rdfs:label>price range</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/servesCuisine -->


    <owl:ObjectProperty rdf:about="http://schema.org/servesCuisine">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Restaurant"/>
        <rdfs:comment>Type of cusine.</rdfs:comment>
        <rdfs:label>serves cuisine</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/starRating -->


    <owl:ObjectProperty rdf:about="http://schema.org/starRating">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Hotel"/>
        <rdfs:comment>Rating of the hotel based on quality standards.</rdfs:comment>
        <rdfs:label>star rating</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/transportation -->


    <owl:ObjectProperty rdf:about="http://schema.org/transportation">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#City"/>
        <rdfs:range rdf:resource="http://smarttourisminspanishcities#Transport"/>
        <rdfs:comment>Transports available in that city.</rdfs:comment>
        <rdfs:label>transportation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://smarttourisminspanishcities#isIdentifiedAs -->


    <owl:ObjectProperty rdf:about="http://smarttourisminspanishcities#isIdentifiedAs">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://smarttourisminspanishcities#isIdentifiedAs"/>
                <owl:someValuesFrom rdf:resource="http://smarttourisminspanishcities#City"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://smarttourisminspanishcities#isIdentifiedAs"/>
                <owl:someValuesFrom rdf:resource="http://smarttourisminspanishcities#City"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment>Connects a city to its identity instance</rdfs:comment>
        <rdfs:label>is identified as</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://smarttourisminspanishcities#night_price -->


    <owl:ObjectProperty rdf:about="http://smarttourisminspanishcities#night_price">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Hotel"/>
        <rdfs:comment>Price per night in that Hotel.</rdfs:comment>
        <rdfs:label>night_price</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://smarttourisminspanishcities#aggregateRating -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#aggregateRating">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://schema.org/aggregateRating"/>
                <owl:someValuesFrom rdf:resource="http://smarttourisminspanishcities#Attraction"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://schema.org/aggregateRating"/>
                <owl:someValuesFrom rdf:resource="http://smarttourisminspanishcities#Hotel"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://schema.org/aggregateRating"/>
                <owl:someValuesFrom rdf:resource="http://smarttourisminspanishcities#Restaurant"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Customers valorations.</rdfs:comment>
        <rdfs:label>Aggregate Rating</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#attractionName -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#attractionName">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The official name of the attraction.</rdfs:comment>
        <rdfs:label>Attraction Name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#attraction_id -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#attraction_id">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Attraction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#cityName -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#cityName">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The official name of the city.</rdfs:comment>
        <rdfs:label>City Name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#city_id -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#city_id">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#City"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#company -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#company">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Transport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#date -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#date">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#eventName -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#eventName">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://schema.org/event"/>
                <owl:someValuesFrom rdf:resource="http://smarttourisminspanishcities#Event"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The official name of the event.</rdfs:comment>
        <rdfs:label>Event Name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#event_id -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#event_id">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#geo -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#geo">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#City"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>Geo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#hasPriceSpecification -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#hasPriceSpecification">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/goodrelations/v1#hasPriceSpecification"/>
                <owl:someValuesFrom rdf:resource="http://smarttourisminspanishcities#Transport"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Average price for travel.</rdfs:comment>
        <rdfs:label>Has Price Specification</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#hotelCategory -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#hotelCategory">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://schema.org/hotelCategory"/>
                <owl:someValuesFrom rdf:resource="http://smarttourisminspanishcities#Hotel"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Type of Hotel.</rdfs:comment>
        <rdfs:label>Hotel Category</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#hotelName -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#hotelName">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The official name of the hotel.</rdfs:comment>
        <rdfs:label>Hotel Name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#hotel_id -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#hotel_id">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#nightPrice -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#nightPrice">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://smarttourisminspanishcities#night_price"/>
                <owl:someValuesFrom rdf:resource="http://smarttourisminspanishcities#Hotel"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Price per night in that Hotel.</rdfs:comment>
        <rdfs:label>Night Price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#priceRange -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#priceRange">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://schema.org/priceRange"/>
                <owl:someValuesFrom rdf:resource="http://smarttourisminspanishcities#Restaurant"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The general price range for services provided, such as meals or transport.</rdfs:comment>
        <rdfs:label>Price Range</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#restaurantName -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#restaurantName">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The official name of the restaurant.</rdfs:comment>
        <rdfs:label>Restaurant Name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#restaurant_id -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#restaurant_id">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Restaurant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#servesCuisine -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#servesCuisine">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://schema.org/servesCuisine"/>
                <owl:someValuesFrom rdf:resource="http://smarttourisminspanishcities#Restaurant"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Type of cusine.</rdfs:comment>
        <rdfs:label>Serves Cuisine</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#starRating -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#starRating">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://schema.org/starRating"/>
                <owl:someValuesFrom rdf:resource="http://smarttourisminspanishcities#Hotel"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Rating of the hotel based on quality standards.</rdfs:comment>
        <rdfs:label>Star Rating</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#transport_id -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#transport_id">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Transport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://smarttourisminspanishcities#type -->


    <owl:DatatypeProperty rdf:about="http://smarttourisminspanishcities#type">
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Attraction"/>
        <rdfs:domain rdf:resource="http://smarttourisminspanishcities#Transport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://smarttourisminspanishcities#AndalusianCuisine -->


    <owl:Class rdf:about="http://smarttourisminspanishcities#AndalusianCuisine">
        <rdfs:subClassOf rdf:resource="http://smarttourisminspanishcities#Restaurant"/>
        <rdfs:comment>Typical dishes of Andalusian cuisine.</rdfs:comment>
        <rdfs:label>Andalusian  Cuisine</rdfs:label>
    </owl:Class>
    


    <!-- http://smarttourisminspanishcities#Attraction -->


    <owl:Class rdf:about="http://smarttourisminspanishcities#Attraction">
        <rdfs:subClassOf rdf:resource="http://smarttourisminspanishcities#Place"/>
        <rdfs:comment>Point of interest for tourists for its cultural, historical, geographical or entertainment value.</rdfs:comment>
        <rdfs:label>Attraction</rdfs:label>
    </owl:Class>
    


    <!-- http://smarttourisminspanishcities#BeachAttraction -->


    <owl:Class rdf:about="http://smarttourisminspanishcities#BeachAttraction">
        <rdfs:subClassOf rdf:resource="http://smarttourisminspanishcities#Attraction"/>
        <rdfs:comment>Attraction located in a coastal area related to mainly aquatic and sailing activities.</rdfs:comment>
        <rdfs:label>Beach Attraction</rdfs:label>
    </owl:Class>
    


    <!-- http://smarttourisminspanishcities#BeachHotel -->


    <owl:Class rdf:about="http://smarttourisminspanishcities#BeachHotel">
        <rdfs:subClassOf rdf:resource="http://smarttourisminspanishcities#Hotel"/>
        <rdfs:comment>Hotel located near the coast where travelers are looking for proximity to the beach and services related to the maritime environment.</rdfs:comment>
        <rdfs:label>Beach Hotel</rdfs:label>
    </owl:Class>
    


    <!-- http://smarttourisminspanishcities#Bike -->


    <owl:Class rdf:about="http://smarttourisminspanishcities#Bike">
        <rdfs:subClassOf rdf:resource="http://smarttourisminspanishcities#Transport"/>
        <rdfs:comment>Human-powered vehicle that moves thanks to the force transmitted to two aligned wheels.</rdfs:comment>
        <rdfs:label>Bike</rdfs:label>
        <rdfs:sameAs>https://dbpedia.org/page/Bicycle</rdfs:sameAs>
    </owl:Class>
    


    <!-- http://smarttourisminspanishcities#Bus -->


    <owl:Class rdf:about="http://smarttourisminspanishcities#Bus">
        <rdfs:subClassOf rdf:resource="http://smarttourisminspanishcities#Transport"/>
        <rdfs:comment>A large motor vehicle that carries passengers by road, usually on fixed routes.</rdfs:comment>
        <rdfs:label>Bus</rdfs:label>
    </owl:Class>
    


    <!-- http://smarttourisminspanishcities#BusinessHotel -->


    <owl:Class rdf:about="http://smarttourisminspanishcities#BusinessHotel">
        <rdfs:subClassOf rdf:resource="http://smarttourisminspanishcities#Hotel"/>
        <rdfs:comment>Hotel focused on business trips with functional rooms and affordable prices.</rdfs:comment>
        <rdfs:label>Business Hotel</rdfs:label>
    </owl:Class>
    


    <!-- http://smarttourisminspanishcities#City -->


    <owl:Class rdf:about="http://smarttourisminspanishcities#City">
        <rdfs:subClassOf rdf:resource="http://smarttourisminspanishcities#Place"/>
        <rdfs:comment>Urban area that offers general interest activities and tourist services.</rdfs:comment>
        <rdfs:label>City</rdfs:label>
        <rdfs:sameAs>http://dbpedia.org/resource/City</rdfs:sameAs>
    </owl:Class>
    


    <!-- http://smarttourisminspanishcities#CountryHotel -->


    <owl:Class rdf:about="http://smarttourisminspanishcities#CountryHotel">
        <rdfs:subClassOf rdf:resource="http://smarttourisminspanishcities#Hotel"/>
        <rdfs:comment>Hotel located in a rural area with rustic aesthetics and rooms.</rdfs:comment>
        <rdfs:label>Country Hotel</rdfs:label>
    </owl:Class>
    


    <!-- http://smarttourisminspanishcities#CulturalAttraction -->


    <owl:Class rdf:about="http://smarttourisminspanishcities#CulturalAttraction">
        <rdfs:subClassOf rdf:resource="http://smarttourisminspanishcities#Attraction"/>
        <rdfs:comment>Attraction with a theme focused on art, history, or local traditions.</rdfs:comment>
        <rdfs:label>Cultural Attraction</rdfs:label>
    </owl:Class>
    


    <!-- http://smarttourisminspanishcities#CulturalEvent -->


    <owl:Class rdf:about="http://smarttourisminspanishcities#CulturalEvent">
        <rdfs:subClassOf rdf:resource="http://smarttourisminspanishcities#Event"/>
        <rdfs:comment>Event that celebrates cultural expressions, such as music, dance or art.</rdfs:comment>
        <rdfs:label>Cultural Event</rdfs:label>
    </owl:Class>
    


    <!-- http://smarttourisminspanishcities#Event -->


    <owl:Class rdf:about="http://smarttourisminspanishcities#Event">
        <rdfs:comment>A scheduled activity or event that offers entertainment to visitors and locals.</rdfs:comment>
        <rdfs:label>Event</rdfs:label>
    </owl:Class>
    


    <!-- http://smarttourisminspanishcities#GastronomicEvent -->


    <owl:Class rdf:about="http://smarttourisminspanishcities#GastronomicEvent">
        <rdfs:subClassOf rdf:resource="http://smarttourisminspanishcities#Event"/>
        <rdfs:comment>Culinary themed event.</rdfs:comment>
        <rdfs:label>Gastronomic Event</rdfs:label>
    </owl:Class>
    


    <!-- http://smarttourisminspanishcities#Hotel -->


    <owl:Class rdf:about="http://smarttourisminspanishcities#Hotel">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://smarttourisminspanishcities#hotel_id"/>
